{
  "name": "ftc-biobuzz-sim",
  "private": true,
  "version": "0.1.0",
  "description": "A browser physics simulator for BIOBUZZ, the 2026-2027 FIRST Tech Challenge game, with the results of thousands of simulated matches.",
  "license": "MIT",
  "homepage": "https://biobuzz.ncssmftc.org/",
  "repository": {
    "type": "git",
    "url": "https://github.com/caryden/ftc-biobuzz-sim.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "app": "node electron/start.mjs",
    "build": "tsc --noEmit && vite build && node scripts/migrate-d1.mjs",
    "test": "vitest run",
    "site": "python3 scripts/build-site.py"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@dimforge/rapier3d-compat": "^0.14.0",
    "@lezer/highlight": "^1.2.5",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "meshoptimizer": "^1.2.0",
    "occt-import-js": "^0.0.23",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "electron-winstaller@5.4.0": true
  }
}
