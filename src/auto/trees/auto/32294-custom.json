{
 "kind": "bt.tree",
 "id": "32294-custom",
 "name": "32294: Custom path",
 "env": "onboard",
 "description": "Team 32294 custom AUTO. Click Edit AUTO paths, then click an orange dot to set intake/turret/shoot for that step.",
 "meta": { "start": "any" },
 "defs": {
  "len": "bots.me.dimensions.length",
  "stop1": "pose(field.hiveX, -1.3, -90)",
  "stop2": "pose(-0.8, -1.5, 0)",
  "stop3": "pose(-0.5,  0.9, 180)"
 },
 "root": {
  "sequence": {
   "children": [
    {
     "id": "s1",
     "note": "Drive to first position. Click this dot to add intake, turret, or shoot.",
     "ref": "drive.driveTo",
     "params": { "pose": "stop1", "timeoutSec": 5 }
    },
    {
     "id": "s2",
     "note": "Drive to second position.",
     "ref": "drive.driveTo",
     "params": { "pose": "stop2", "timeoutSec": 5 }
    },
    {
     "id": "s3",
     "note": "Drive to third position.",
     "ref": "drive.driveTo",
     "params": { "pose": "stop3", "timeoutSec": 5 }
    }
   ]
  }
 }
}
